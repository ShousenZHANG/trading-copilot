{
  "mcpServers": {
    "yahoo-finance": {
      "command": "uvx",
      "args": [
        "--with",
        "mcp<2",
        "yahoo-finance-mcp"
      ]
    },
    "finnhub": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--script",
        "mcps/finnhub_mcp.py"
      ],
      "env": {
        "FINNHUB_API_KEY": "${FINNHUB_API_KEY}"
      }
    },
    "trading-copilot": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--script",
        "mcps/copilot_mcp.py"
      ]
    }
  }
}
