{
  "mcpServers": {
    "yahoo-finance": {
      "command": "uv",
      "args": [
        "run", "--no-project", "--quiet", "--locked", "--script", "mcps/yahoo_mcp.py"
      ]
    },
    "finnhub": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--script",
        "mcps/finnhub_mcp.py"
      ],
      "env": {
        "FINNHUB_API_KEY": "${FINNHUB_API_KEY}"
      }
    },
    "trading-copilot": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--quiet",
        "--script",
        "scripts/copilot_runtime.py",
        "mcp"
      ]
    }
  }
}
