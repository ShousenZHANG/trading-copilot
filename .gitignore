# Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Personal trading state (do not commit positions/portfolio)
data/positions.md
data/watchlist.local.md
data/runs/
data/memory/trading_memory.md
data/audit/
# Telegram push dedup: sha256(ticker|date|rating). The preimage space is tiny,
# so publishing this file publishes the signal history it was meant to dedup.
data/state/

# Personal decision outputs — each run writes the user's actual analysis here.
# Instance state, NOT shippable plugin content. Curated demos live in docs/samples/.
data/decisions/

# Personal strategy (each user writes their own; not shippable plugin content)
docs/strategy.md
docs/strategy-checklist.md

# Personal adopted parameters (universe, capital, constraints). The example ships; this does not.
config/user.toml

# Release build artifacts
dist/
*.zip

# Reference clones (cloned via git, no need to vendor)
# `reference/*` rather than `reference/`: git cannot re-include a file whose
# parent directory is excluded, so the directory itself has to stay visible for
# the negation below to be reachable at all.
reference/*

# The one vendored exception. The offline CI matrix installs zero third-party
# packages and has no network, so the gold backtest can only run against a
# series held in the tree — see scripts/refresh_gold_prices.py.
!reference/sge-au9999-daily.csv

