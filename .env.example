# Free-data core. Copy to .env; never commit real credentials.
# Empty entries remain not_configured. Presence is not proof of API entitlement.

# Finnhub free company news: https://finnhub.io/
FINNHUB_API_KEY=

# Alpaca free account: https://alpaca.markets/
# Historical SIP access is probed; IEX must never impersonate consolidated SIP.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# FRED free API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# SEC public data requires a real identifying User-Agent/contact, not an API key.
# Example format: YourName contact@example.com (replace with your actual contact).
SEC_USER_AGENT=

# Optional process environment override for a separate local journal:
# COPILOT_DB_PATH=/absolute/path/copilot.sqlite
# Default: data/state/copilot.sqlite. Both clients use the same repository.
